---
layout: layouts/base.njk
title: "Terms & Conditions"
description: "KD Holidayz terms and conditions for bookings, payments, suppliers and travel services."
---
{% import "partials/page-banner.njk" as banner with context %}
{% import "partials/icons.njk" as icon %}
{% set india = company.offices[0] %}
{% set kenya = company.offices[1] %}

{{ banner.render([{"label":"Home","url":"/"},{"label":"Terms & Conditions"}], "📜 Please Read", "Terms & Conditions", null, "terms") }}

<section class="privacy-v2">
  <div class="container">
    <div class="legal-meta text-muted">
      <span class="pill">Effective Date: 22 September 2026</span>
      <span class="pill">Last Updated: 22 September 2026</span>
    </div>

    <div class="privacy-v2__layout">
      <aside class="privacy-v2__sidebar">
        <div class="card privacy-v2__sidebar-card">
          <div class="privacy-v2__progress" aria-hidden="true"><div class="privacy-v2__progress-bar" id="pvProgressBar"></div></div>
          <div class="privacy-v2__meta text-muted">📖 29 sections · ~7 min read</div>
          <nav class="privacy-v2__nav" id="pvNav" aria-label="Terms & conditions categories">
            <a href="#cat-about" data-cat="cat-about"><span class="privacy-v2__nav-icon">{{ icon.render("tag", 16) }}</span>About &amp; Acceptance</a>
            <a href="#cat-booking" data-cat="cat-booking"><span class="privacy-v2__nav-icon">{{ icon.render("coin", 16) }}</span>Quotations, Booking &amp; Payments</a>
            <a href="#cat-services" data-cat="cat-services"><span class="privacy-v2__nav-icon">{{ icon.render("globe", 16) }}</span>Travel Services &amp; Suppliers</a>
            <a href="#cat-changes" data-cat="cat-changes"><span class="privacy-v2__nav-icon">{{ icon.render("compass", 16) }}</span>Changes &amp; Force Majeure</a>
            <a href="#cat-responsibilities" data-cat="cat-responsibilities"><span class="privacy-v2__nav-icon">{{ icon.render("person", 16) }}</span>Your Responsibilities</a>
            <a href="#cat-website" data-cat="cat-website"><span class="privacy-v2__nav-icon">{{ icon.render("note", 16) }}</span>Website, Communication &amp; Liability</a>
            <a href="#cat-legal" data-cat="cat-legal"><span class="privacy-v2__nav-icon">{{ icon.render("mail", 16) }}</span>Legal &amp; Contact</a>
          </nav>
          <div class="privacy-v2__actions">
            <button type="button" class="btn btn--ghost btn--sm" id="pvExpandAll">Expand All</button>
            <button type="button" class="btn btn--ghost btn--sm" id="pvCollapseAll">Collapse All</button>
          </div>
        </div>
      </aside>

      <div class="privacy-v2__main">
        <section class="privacy-v2__category" id="cat-about">
          <div class="privacy-v2__category-head">
            <span class="privacy-v2__category-icon">{{ icon.render("tag", 20) }}</span>
            <h2>About &amp; Acceptance</h2>
          </div>
          <div class="accordion accordion--legal">
            <div class="accordion__item is-open">
              <button class="accordion__trigger" type="button" aria-expanded="true">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">1. About KD Holidayz</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>KD Holidayz is a registered proprietorship based in Jamnagar, Gujarat, India, providing domestic and international travel services including customised holidays, tour packages, flights, hotels, visa assistance, travel insurance, MICE and group travel services.</p>
              </div></div>
            </div>
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">2. Acceptance of Terms</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>By using the KD Holidayz website, requesting a quotation, making an enquiry, paying an advance, confirming a booking or using our services, the customer agrees to these Terms &amp; Conditions. Service-specific terms, supplier conditions and written booking confirmations may also apply.</p>
              </div></div>
            </div>
          </div>
        </section>

        <section class="privacy-v2__category" id="cat-booking">
          <div class="privacy-v2__category-head">
            <span class="privacy-v2__category-icon">{{ icon.render("coin", 20) }}</span>
            <h2>Quotations, Booking &amp; Payments</h2>
          </div>
          <div class="accordion accordion--legal">
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">3. Quotations and Pricing</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>All quotations are subject to availability and supplier confirmation at the time of booking. Prices may change due to airfare, hotel availability, exchange rates, taxes, fuel surcharges, government charges, supplier revisions or other circumstances. A quotation is not a confirmed booking until KD Holidayz confirms the booking and the required payment is received.</p>
              </div></div>
            </div>
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">4. Booking Confirmation</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>A booking is considered confirmed only after the applicable payment/advance has been received and KD Holidayz has issued a confirmation or other written confirmation. Verbal discussions or provisional quotations do not by themselves constitute a confirmed booking.</p>
              </div></div>
            </div>
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">5. Customer Information</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>Customers must provide accurate names, passport details, dates of birth, travel dates, contact details and other information required for the service. KD Holidayz is not responsible for consequences arising from incorrect, incomplete or late information supplied by the customer, to the extent permitted by law.</p>
              </div></div>
            </div>
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">6. Payments</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>Payments must be made according to the payment schedule communicated in the quotation or invoice. Certain suppliers may require full payment before travel. Bank charges, payment gateway charges, currency conversion costs and other applicable charges may be payable by the customer where communicated.</p>
              </div></div>
            </div>
          </div>
        </section>

        <section class="privacy-v2__category" id="cat-services">
          <div class="privacy-v2__category-head">
            <span class="privacy-v2__category-icon">{{ icon.render("globe", 20) }}</span>
            <h2>Travel Services &amp; Suppliers</h2>
          </div>
          <div class="accordion accordion--legal">
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">7. Supplier Terms</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>Flights, hotels, resorts, cruises, tours, transfers, activities, insurance and visa services are often supplied by independent third parties. Their fare rules, cancellation policies, amendment conditions, baggage rules, check-in requirements and other terms may apply in addition to KD Holidayz terms.</p>
              </div></div>
            </div>
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">8. Air Tickets</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>Airline schedules, fares, baggage allowances, seat assignments, check-in rules and flight operations are controlled by the relevant airline. KD Holidayz cannot guarantee a particular seat, aircraft, schedule or operational outcome unless expressly confirmed. Airline cancellation, change, no-show and refund rules apply.</p>
              </div></div>
            </div>
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">9. Hotels and Resorts</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>Hotel and resort facilities, room categories, meal plans, check-in/check-out times, extra beds, child policies, deposits and other conditions are determined by the property. Photographs and descriptions are intended as general representations and may change. Equivalent or alternative accommodation may be offered where permitted by the confirmed booking or supplier terms.</p>
              </div></div>
            </div>
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">10. Tour Packages and Activities</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>Itineraries are prepared based on available information and supplier confirmations. Operational conditions, weather, local events, road conditions, government restrictions, supplier changes or other circumstances may require changes to an itinerary. KD Holidayz will communicate material changes where reasonably practicable.</p>
              </div></div>
            </div>
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">11. Visa Assistance</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>KD Holidayz may provide visa assistance as a travel service but does not control embassy, consulate or immigration decisions. Visa approval is never guaranteed unless expressly stated by the relevant authority. Customers remain responsible for providing genuine and complete documents and meeting immigration requirements.</p>
              </div></div>
            </div>
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">12. Travel Documents</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>Customers are responsible for checking names, dates, passport validity, visa validity, tickets, hotel confirmations and other travel documents immediately after receiving them and before travel.</p>
              </div></div>
            </div>
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">13. Travel Insurance</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>Travel insurance is recommended for international and domestic travel where appropriate. Coverage, exclusions, claims and settlement are determined by the relevant insurer and policy. KD Holidayz is not the insurer unless expressly stated.</p>
              </div></div>
            </div>
          </div>
        </section>

        <section class="privacy-v2__category" id="cat-changes">
          <div class="privacy-v2__category-head">
            <span class="privacy-v2__category-icon">{{ icon.render("compass", 20) }}</span>
            <h2>Changes &amp; Force Majeure</h2>
          </div>
          <div class="accordion accordion--legal">
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">14. Changes by Customer</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>Customer-requested changes may attract airline, hotel, supplier, visa, transport, administrative or other charges. Any applicable charges will be communicated where reasonably available. Changes are subject to availability and supplier rules.</p>
              </div></div>
            </div>
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">15. Cancellation and Refunds</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>Cancellation and refund eligibility depends on the specific booking, supplier rules and the cancellation/refund policy communicated at the time of booking. Separate KD Holidayz <a href="/cancellation-refund-policy/">Cancellation &amp; Refund Policy</a> may apply. Some bookings may be non-refundable. Refunds received from suppliers will be passed to the customer after applicable deductions, subject to the applicable terms.</p>
              </div></div>
            </div>
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">16. Delays, Cancellations and Force Majeure</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>KD Holidayz is not responsible for events outside its reasonable control, including natural disasters, severe weather, pandemics, epidemics, strikes, civil unrest, war, terrorism, government restrictions, airline operational issues, airport closures, border restrictions, supplier failure or other force majeure events. Assistance may be provided where reasonably possible, but additional costs may be borne by the customer where supplier or law does not provide otherwise.</p>
              </div></div>
            </div>
          </div>
        </section>

        <section class="privacy-v2__category" id="cat-responsibilities">
          <div class="privacy-v2__category-head">
            <span class="privacy-v2__category-icon">{{ icon.render("person", 20) }}</span>
            <h2>Your Responsibilities</h2>
          </div>
          <div class="accordion accordion--legal">
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">17. Health, Safety and Travel Requirements</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>Customers are responsible for checking health, vaccination, passport validity, visa, entry, transit, customs and other requirements applicable to their journey. Travellers should obtain appropriate medical and travel advice before departure.</p>
              </div></div>
            </div>
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">18. Customer Conduct</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>Customers must comply with laws, hotel rules, airline rules, local regulations and instructions of service providers. KD Holidayz may assist with supplier communications where a customer's conduct results in additional charges, penalties or service termination, but the customer remains responsible for such consequences.</p>
              </div></div>
            </div>
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">19. Children and Special Requirements</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>Customers must disclose relevant child ages, accessibility requirements, dietary needs and other special requirements at the time of booking. Availability and additional charges are determined by suppliers.</p>
              </div></div>
            </div>
          </div>
        </section>

        <section class="privacy-v2__category" id="cat-website">
          <div class="privacy-v2__category-head">
            <span class="privacy-v2__category-icon">{{ icon.render("note", 20) }}</span>
            <h2>Website, Communication &amp; Liability</h2>
          </div>
          <div class="accordion accordion--legal">
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">20. Communication</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>KD Holidayz may communicate through phone, email, WhatsApp or other agreed channels. Customers should provide active contact details and monitor communications, especially before and during travel.</p>
              </div></div>
            </div>
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">21. Website Information</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>KD Holidayz aims to keep website information accurate but does not guarantee that every description, price, image, availability indication or promotional statement remains current at all times. Final booking documents and supplier confirmations prevail for the specific booking.</p>
              </div></div>
            </div>
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">22. Third-Party Links and Services</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>The website may contain links to third-party websites and services. KD Holidayz is not responsible for their content, availability, security, policies or performance.</p>
              </div></div>
            </div>
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">23. Limitation of Responsibility</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>KD Holidayz acts as a travel consultant/agent and tour operator for the services it offers, while many travel components are provided by independent suppliers. Liability, where applicable, is subject to the confirmed booking terms, supplier conditions and applicable law. Nothing in these terms excludes liability that cannot lawfully be excluded.</p>
              </div></div>
            </div>
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">24. Complaints</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>Customers should report service issues to KD Holidayz as soon as reasonably possible so that we can communicate with the relevant supplier and attempt to resolve the matter during the trip. Written complaints should be submitted promptly after the service concerned.</p>
              </div></div>
            </div>
          </div>
        </section>

        <section class="privacy-v2__category" id="cat-legal">
          <div class="privacy-v2__category-head">
            <span class="privacy-v2__category-icon">{{ icon.render("mail", 20) }}</span>
            <h2>Legal &amp; Contact</h2>
          </div>
          <div class="accordion accordion--legal">
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">25. Privacy</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>Personal information is handled in accordance with the KD Holidayz <a href="/privacy-policy/">Privacy Policy</a>. By using our services, customers acknowledge that relevant information may need to be shared with airlines, hotels, DMCs, visa providers, insurers and other suppliers to fulfil the booking.</p>
              </div></div>
            </div>
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">26. Amendments to Terms</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>KD Holidayz may update these Terms &amp; Conditions from time to time. The version applicable to a booking will generally be the version communicated or accepted at the time of confirmation, subject to applicable law and any later agreed amendments.</p>
              </div></div>
            </div>
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">27. Governing Law and Jurisdiction</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>These Terms &amp; Conditions are governed by applicable laws of India. Subject to applicable consumer protection and other mandatory laws, disputes shall be subject to the competent courts having jurisdiction over KD Holidayz's principal place of business.</p>
              </div></div>
            </div>
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">28. Contact Details</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>KD Holidayz, Registered Proprietorship</p>
                <div class="legal-offices">
                  <div class="legal-office">
                    <span class="pill office-card__label">India</span>
                    <div class="office-card__row"><span class="text-muted">{{ icon.render("pin", 18) }}</span><span>{{ india.address }}</span></div>
                    {% for phone in india.phones %}<div class="office-card__row"><span class="text-muted">{{ icon.render("phone", 18) }}</span><a href="{{ phone | telLink }}">{{ phone }}</a></div>{% endfor %}
                    <div class="office-card__row"><span class="text-muted">{{ icon.render("mail", 18) }}</span><a href="mailto:{{ india.email }}">{{ india.email }}</a></div>
                  </div>
                  <div class="legal-office">
                    <span class="pill office-card__label">Kenya Branch</span>
                    <div class="office-card__row"><span class="text-muted">{{ icon.render("pin", 18) }}</span><span>{{ kenya.address }}</span></div>
                    {% for phone in kenya.phones %}<div class="office-card__row"><span class="text-muted">{{ icon.render("phone", 18) }}</span><a href="{{ phone | telLink }}">{{ phone }}</a></div>{% endfor %}
                    <div class="office-card__row"><span class="text-muted">{{ icon.render("mail", 18) }}</span><a href="mailto:{{ kenya.email }}">{{ kenya.email }}</a></div>
                  </div>
                </div>
              </div></div>
            </div>
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">29. Customer Acknowledgement</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>By proceeding with a booking or using KD Holidayz services, the customer confirms that they have had an opportunity to review these Terms &amp; Conditions and the terms applicable to their specific service.</p>
              </div></div>
            </div>
          </div>
        </section>

        <p class="text-muted" style="text-align:center; margin-top:var(--space-6);">© 2026 KD Holidayz. All Rights Reserved.</p>
      </div>
    </div>
  </div>
</section>

<script>
(function () {
  var progressBar = document.getElementById("pvProgressBar");
  if (progressBar) {
    var onScroll = function () {
      var el = document.documentElement;
      var scrollTop = el.scrollTop || document.body.scrollTop;
      var height = el.scrollHeight - el.clientHeight;
      var pct = height > 0 ? (scrollTop / height) * 100 : 0;
      progressBar.style.width = pct + "%";
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }

  var navLinks = document.querySelectorAll("#pvNav a");
  var categories = document.querySelectorAll(".privacy-v2__category");
  if (categories.length && navLinks.length && "IntersectionObserver" in window) {
    var obs = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        navLinks.forEach(function (l) { l.classList.remove("is-active"); });
        var link = document.querySelector('#pvNav a[data-cat="' + entry.target.id + '"]');
        if (link) link.classList.add("is-active");
      });
    }, { rootMargin: "-15% 0px -70% 0px", threshold: 0 });
    categories.forEach(function (c) { obs.observe(c); });
  }

  var expandBtn = document.getElementById("pvExpandAll");
  var collapseBtn = document.getElementById("pvCollapseAll");
  function setAll(open) {
    document.querySelectorAll(".privacy-v2 .accordion__item").forEach(function (item) {
      item.classList.toggle("is-open", open);
      var trigger = item.querySelector(".accordion__trigger");
      if (trigger) trigger.setAttribute("aria-expanded", String(open));
    });
  }
  if (expandBtn) expandBtn.addEventListener("click", function () { setAll(true); });
  if (collapseBtn) collapseBtn.addEventListener("click", function () { setAll(false); });
})();
</script>
